{
  "name": "cli-pocket-webview-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:tauri": "vite build --mode tauri --outDir dist/tauri",
    "build:web": "vite build --mode web --outDir dist/web",
    "build": "npm run build:tauri && npm run build:web",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\"",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-unicode11": "0.8.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "5.5.0"
  },
  "devDependencies": {
    "@types/node": "20.12.7",
    "@typescript-eslint/eslint-plugin": "7.7.0",
    "@typescript-eslint/parser": "7.7.0",
    "eslint": "8.57.0",
    "prettier": "3.2.5",
    "typescript": "5.4.5",
    "vite": "5.2.10",
    "vitest": "1.5.0"
  },
  "optionalDependencies": {
    "@tauri-apps/api": "^2.11.0"
  }
}
