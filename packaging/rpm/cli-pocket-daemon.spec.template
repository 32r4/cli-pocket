Name:           cli-pocket-daemon
Version:        @VERSION@
Release:        1%{?dist}
Summary:        cli-pocket daemon
License:        MIT OR Apache-2.0
URL:            https://github.com/32r4/cli-pocket

Requires(pre):  shadow-utils
Requires:       systemd

%description
The cli-pocket host daemon, exposing PTY sessions over an end-to-end-encrypted
Noise channel to authenticated clients.

%install
mkdir -p %{buildroot}/usr/bin
mkdir -p %{buildroot}/lib/systemd/system
install -m 0755 cli-pocket-daemon %{buildroot}/usr/bin/cli-pocket-daemon
install -m 0644 cli-pocket-daemon.service %{buildroot}/lib/systemd/system/cli-pocket-daemon.service

%pre
getent group  cli-pocket >/dev/null || groupadd --system cli-pocket
getent passwd cli-pocket >/dev/null || \
    useradd --system -g cli-pocket -d /var/lib/cli-pocket -s /usr/sbin/nologin cli-pocket

%files
/usr/bin/cli-pocket-daemon
/lib/systemd/system/cli-pocket-daemon.service

